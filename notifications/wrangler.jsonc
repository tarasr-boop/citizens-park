// How the alerts backend is set up on Cloudflare. The tool that puts it there
// ("wrangler") reads this file. See the README for what the backend does.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citizens-bark-alerts",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  // The backend's public address: a name under the page's own domain, which
  // Cloudflare sets up by itself. It is not given an address at workers.dev,
  // because that one would show the name of the Cloudflare account.
  //
  // Careful: a deploy from GitHub takes this name over, whatever it pointed
  // to before. So it must never be the page's own name, or "www" before it.
  // The tests refuse both.
  "routes": [{ "pattern": "alerts.citizensbark.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // These must say the same as config.toml and .github/workflows/daily.yml.
  // The tests check that they do.
  "vars": {
    // The page's address. Only this page may add or remove a device.
    "SITE_URL": "https://citizensbark.com/",
    "TIMEZONE": "Australia/Melbourne",
    // The alert goes out once a day: at about the first time from Monday to
    // Friday and at about the second on Saturday and Sunday, as soon as the
    // check that goes with it has run. An alert that could not go out by
    // ALERT_UNTIL is left out for the day.
    "ALERT_WEEKDAYS": "16:00",
    "ALERT_WEEKENDS": "08:00",
    "ALERT_UNTIL": "19:00",
    // The second timer: the check on GitHub that it starts when GitHub's own
    // timer has not, and the times of day, at the park, at which GitHub is
    // asked to run it. Make CHECK_TIMES empty ("") to switch the second
    // timer off. It also stays off until the secret DAILY_CHECK_TOKEN
    // exists (see the README).
    "CHECK_REPOSITORY": "tarasr-boop/citizens-park",
    "CHECK_WORKFLOW": "daily.yml",
    "CHECK_BRANCH": "main",
    "CHECK_TIMES": "06:17 07:40 08:10 08:45 11:47 14:47 15:40 16:10 16:45 17:47 19:47",
    // The Telegram bot: its name for the park, and where Telegram brings what
    // people write to it (this backend's own address). People pick an hour
    // from BOT_FIRST to BOT_LAST, once for weekdays and once for weekends; a
    // new chat starts with BOT_WEEKDAY and BOT_WEEKEND; an alert at
    // BOT_EVENING or later is about the next day. The [bot] section of
    // config.toml says the same. The bot stays off until the secret
    // TELEGRAM_BOT_TOKEN has been handed over (see the README).
    "PARK_NAME": "Citizens Park oval",
    "BACKEND_URL": "https://alerts.citizensbark.com",
    "BOT_FIRST": "04:00",
    "BOT_LAST": "23:00",
    "BOT_EVENING": "21:00",
    "BOT_WEEKDAY": "16:00",
    "BOT_WEEKEND": "08:00",
    // A button under each person's times, and where it leads. Make BOT_LINK
    // empty ("") to leave it out.
    "BOT_LINK": "https://www.instagram.com/gentle_woof",
    "BOT_LINK_TEXT": "Book a consultation with Sofia"
  },

  // The timer. The first line is every five minutes, except from noon to 7 PM
  // in UTC. In Melbourne that leaves out 11 PM to 6 AM during daylight saving
  // time and 10 PM to 5 AM in winter. Either way it covers the alert on
  // weekdays and on weekends, and every time in CHECK_TIMES with the hour and
  // a quarter after it.
  // The second line adds the first half hour of the bot's early and late
  // hours that the first leaves out, so that each hour from BOT_FIRST to
  // BOT_LAST gets its look in summer and in winter. Cloudflare's timers only
  // know UTC.
  "triggers": { "crons": ["*/5 0-11,19-23 * * *", "0-25/5 12,13,17,18 * * *"] },

  // The book of devices, the counter behind the stats page, and the Telegram
  // bot's chats: three objects, each with its own small database.
  "durable_objects": {
    "bindings": [
      { "name": "SUBSCRIBERS", "class_name": "Subscribers" },
      { "name": "STATS", "class_name": "Stats" },
      { "name": "CHATS", "class_name": "Chats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Subscribers"] },
    { "tag": "v2", "new_sqlite_classes": ["Stats"] },
    { "tag": "v3", "new_sqlite_classes": ["Chats"] }
  ],

  // Keep what the backend writes to its log, to look at in Cloudflare's dashboard.
  "observability": { "enabled": true }
}
